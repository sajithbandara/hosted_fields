<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>
    <script src="https://js.braintreegateway.com/web/3.85.3/js/client.min.js"></script>
    <script src="https://js.braintreegateway.com/web/3.85.3/js/hosted-fields.min.js"></script>
  </head>
  <body class="bg-light">
    <div class="container">
      <div class="text-center">
        <h2>Braintree Hosted Fields Checkout</h2>
        <p class="lead">Enter your test card details below to create a new transaction</p>
      </div>

      <%= form_tag("/checkouts", method: "post", id: "my-sample-form") do %>

        <div class="col-md-3 mb-3">
          <label for="card-number">Credit Card Number</label>
          <div class="form-control" id="card-number"></div>
        </div>
        <div class="col-md-3 mb-3">
          <label for="cvv">CVV</label>
          <div class="form-control" id="cvv"></div>
        </div>
        <div class="col-md-3 mb-3">
          <label for="expiration-date">Expiration Date</label>
          <div class="form-control" id="expiration-date"></div>
        </div>

        <div class="col-md-3 mb-3">
        <label for="amount">
        <span class="input-label">Amount</span>
          <div class="input-wrapper amount-wrapper">
            <input id="amount" name="amount" type="number" min="1" step="0.01" placeholder="Amount" value="10">
          </div>
        </label>

        <input type="hidden" id="nonce" name="payment_method_nonce" />

        <hr class="my-4">
        <input class="btn btn-primary btn-lg" type="submit" value="Pay">

      <% end %>

      <p class="my-3 lead">
        <%= link_to 'Transaction history page', checkouts_path %>
      </p>
    </div>

    <script>
      var form = document.querySelector('#my-sample-form');
      var submit = document.querySelector('input[type="submit"]');

      braintree.client.create({
        authorization: '<%= @client_token %>'
      }, function (clientErr, clientInstance) {
        if (clientErr) {
          console.error(clientErr);
          return;
        }

        braintree.hostedFields.create({
          client: clientInstance,
          styles: {
            'input': {
              'font-size': '16px'
            },
            'input.invalid': {
              'color': 'red'
            },
            'input.valid': {
              'color': 'green'
            }
          },
          fields: {
            number: {
              selector: '#card-number',
              placeholder: '4111 1111 1111 1111'
            },
            cvv: {
              selector: '#cvv',
              placeholder: '123'
            },
            expirationDate: {
              selector: '#expiration-date',
              placeholder: 'MM/YY'
            }
          }
        }, function (hostedFieldsErr, hostedFieldsInstance) {
          if (hostedFieldsErr) {
            console.error(hostedFieldsErr);
            return;
          }

          submit.removeAttribute('disabled');

          form.addEventListener('submit', function (event) {
            event.preventDefault();

            hostedFieldsInstance.tokenize(function (tokenizeErr, payload) {
              if (tokenizeErr) {
                console.error(tokenizeErr);
                alert("Please enter valid credit card details.")
                return;
              } 

              console.log('Got a nonce: ' + payload.nonce);
              document.querySelector('#nonce').value = payload.nonce;
              form.submit();
            });
          }, false);
        });
      });
    </script>
  </body>
</html>